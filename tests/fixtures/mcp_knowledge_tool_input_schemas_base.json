       "type": "null"
      }
     ],
     "default": null,
     "description": "Optional list of feature names to unpin (set pinned=false)."
    }
   },
   "required": [
    "project_key",
    "current_focus",
    "expected_focus_revision"
   ],
   "type": "object"
