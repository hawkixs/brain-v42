  "brain_update_project_focus": {
   "additionalProperties": false,
   "properties": {
    "allow_focus_shrink": {
     "default": false,
     "description": "Operator only. True lets a `current_focus` under 70% of the current focus length through; otherwise it is refused (`base_focus_shrink`, both sizes in the message) and nothing is written, roadmap changes included.",
     "type": "boolean"
    },
    "blockers": {
     "anyOf": [
      {
       "items": {
        "maxLength": 2000,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
