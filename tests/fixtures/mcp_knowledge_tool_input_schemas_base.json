      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Optional list of current blockers."
    },
    "current_focus": {
     "description": "New current focus. It REPLACES the whole project focus, and a text under 70% of the current length is refused (`base_focus_shrink`) unless `allow_focus_shrink` is true (operator only).",
     "maxLength": 10000,
     "type": "string"
    },
    "expected_focus_revision": {
     "description": "Revision returned by session start/resume.",
     "minimum": 0,
     "type": "integer"
    },
    "feature_status": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Optional dict mapping feature name -> new status.\nExample: {\"Core Monitoring\": \"deployed\", \"GPU Collector\": \"building\"}\nFeatures in this dict are automatically pinned."
    },
    "project_key": {
     "description": "The project key to update.",
     "type": "string"
    },
    "unpin": {
     "anyOf": [
      {
       "items": {
        "maxLength": 2000,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
