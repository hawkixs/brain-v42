# Copy this file to .env and fill in real values: `cp .env.example .env`.
# .env is gitignored; this file is the checked-in template — never put a real
# secret in it (placeholders only).
#
# `pytest tests/unit` needs NONE of this: it runs with no database, no Neo4j
# and no embedding service (see README "Development" / CONTRIBUTING "Running
# the tests"). This file matches what `docker compose up -d` and a local MCP
# server actually read.

# --- Required ---
# PostgreSQL connection URL, asyncpg driver only (postgresql+asyncpg://, not
# postgresql://). Matches the docker-compose default user/db (brain/brain) and
# the loopback-only port compose publishes (5433 on the host). Its password
# MUST equal POSTGRES_PASSWORD below: change both together.
POSTGRES_URL=postgresql+asyncpg://brain:change-me-locally@localhost:5433/brain

# The password docker-compose.yml creates the postgres container with (compose
# reads this file). Same value as in POSTGRES_URL above.
POSTGRES_PASSWORD=change-me-locally
# Optional overrides for the container, default brain/brain; if you change
# them, change POSTGRES_URL to match.
# POSTGRES_USER=brain
# POSTGRES_DB=brain

# --- Optional — semantic search and reranking ---
EMBEDDING_SERVICE_URL=http://localhost:8003
EMBEDDING_DIMENSION=1536
RERANKER_URL=http://localhost:8003

# --- Optional — point at any OpenAI-compatible endpoint instead of the bundled stack ---
BRAIN_EMBEDDING_BACKEND=shim
BRAIN_EMBEDDING_MODEL=qodo
BRAIN_EMBEDDING_QUERY_PREFIX=
BRAIN_EMBEDDING_DOCUMENT_PREFIX=
BRAIN_RERANK_BACKEND=shim

# --- Optional — relationship graph (safe defaults for a fresh environment) ---
GRAPH_ENABLED=false
GRAPH_LEDGER_WRITE_ENABLED=false

# --- Tool catalog profile ---
BRAIN_MCP_PROFILE=compact

# --- Observable delivery MCP mutations; reads and completion guards stay active ---
BRAIN_DELIVERY_ENABLED=false

LOG_LEVEL=INFO

# Never put MCP_HTTP_TOKEN, MCP_HTTP_DREAM_TOKENS, BRAIN_EMBEDDING_API_KEY or
# BRAIN_RERANK_API_KEY here: those are secrets and belong in a private 0600
# file, never the shared .env. See README "Configuration (.env)" and
# docs/OPERATIONS.md.
