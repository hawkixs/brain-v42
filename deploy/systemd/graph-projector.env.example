# Keep GRAPH_ENABLED and GRAPH_LEDGER_WRITE_ENABLED in the shared repository
# environment so every legacy writer guard sees the canonical cutover state.
# Copy only this private role to ~/.config/brain-v42/graph-projector.env,
# replace the password, then chmod 0600.
GRAPH_PROJECTOR_ENABLED=true
GRAPH_PROJECTOR_NEO4J_URL=bolt://127.0.0.1:7687
GRAPH_PROJECTOR_NEO4J_USER=neo4j
GRAPH_PROJECTOR_NEO4J_PASSWORD=REPLACE_WITH_ROTATED_PASSWORD
