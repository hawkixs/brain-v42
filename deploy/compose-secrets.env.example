# Where docker-compose.yml finds the secrets it bind-mounts. Copy these two
# lines into the repository's `.env` (gitignored, 0600) and point them at the
# real files; Compose reads `.env` on its own, so no ad-hoc export is needed.
#
# The versioned defaults in docker-compose.yml point under `./.secrets/`. That
# directory is gitignored and does not exist on an already-running host: it is
# the fresh-install path, not the operating one. Leaving these variables unset
# on a live host is what makes a bare `docker compose up -d` fail on the first
# service whose secret source does not resolve.
#
# Compose bind-mounts a file secret AS-IS: the mode the container sees is the
# mode on the host. The shim REFUSES anything readable beyond its owner and will
# not start; Neo4j checks nothing, so its file is the one that can rot to 0644
# unnoticed. Both should be 0600. Neither is ever committed.
BRAIN_NEO4J_AUTH_FILE=/home/<user>/.config/brain-v42/neo4j-auth
BRAIN_SHIM_BEARER_FILE=/home/<user>/.config/brain-v42/embedding-shim-bearer
